# Client-safe public Supabase configuration. These values may be present in the browser.
# Public keys are not authorization controls; Supabase Auth and PostgreSQL RLS enforce access.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional, privileged server-only key. Do not add a VITE_ prefix or expose it to browser code.
# Not required for normal sponsor-scoped operations; use only for trusted server work if needed.
SUPABASE_SECRET_KEY=your-server-only-secret-key
